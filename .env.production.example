# The production server's .env (copy to /opt/papersweekly/.env, chmod 600).
# docker-compose.prod.yml reads it; never commit the filled-in copy.
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Database password (new; not the Mac's digest_pass)
POSTGRES_PASSWORD=
# Signs confirm, manage and unsubscribe links. New for production: links
# signed by the Mac's key stop working, which is fine before launch.
SECRET_KEY=
ADMIN_TOKEN=
PUBLIC_BASE_URL=https://papersweekly.com

# OpenAI (the production project with the ~$55 hard limit)
SUMMARY_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MONTHLY_BUDGET_USD=50
# Spend and pipeline alerts go here
ALERT_EMAIL=

# Gmail SMTP: an app password (Google Account > Security > App passwords).
# The From address must be that same Gmail address, or Gmail rewrites it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Cloudflare Turnstile (hostname list must include papersweekly.com)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: fresher author h-indices; without it OpenAlex is used
SEMANTIC_SCHOLAR_API_KEY=
