DATABASE_URL=postgresql+psycopg2://digest_user:digest_pass@localhost:5432/digest_db

# Optional: Anthropic API key for paper summarization + digest overviews.
# Billed separately from a claude.ai subscription (console.anthropic.com).
# Left unset, the app runs in no-summary mode: digests and emails still work,
# just without AI-written text - nothing fails or retries because of it.
# ANTHROPIC_API_KEY=your-key-here

# Free alternative: summarize with a local model via Ollama (runs natively on
# the Mac - `brew install ollama && brew services start ollama && ollama pull
# gemma3:12b`). No API key or per-call cost.
# SUMMARY_BACKEND=ollama
# OLLAMA_MODEL=gemma3:12b
# OLLAMA_BASE_URL=http://host.docker.internal:11434   # docker-compose default

# Recommended: Semantic Scholar API key (free) for the author h-index used to
# rank papers when a subscription caps how many it gets. Works without one,
# but keyless requests share a public pool that's often rate-limited - the
# ranking then just goes without that signal for the email.
# https://www.semanticscholar.org/product/api#api-key-form
# SEMANTIC_SCHOLAR_API_KEY=your-key-here

# Optional overrides (defaults shown)
# SUMMARY_MODEL=claude-haiku-4-5
# OVERVIEW_MODEL=claude-sonnet-5
# ARXIV_MAX_RESULTS=25
# ARXIV_PAGE_DELAY=3.0
# ARXIV_LOOKBACK_DAYS=7
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=digest-task-queue

# Email delivery (SMTP). Defaults point at Mailpit (docker-compose) - nothing
# leaves the machine until these are pointed at a real relay.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# SMTP_FROM_ADDRESS=digest@example.com
