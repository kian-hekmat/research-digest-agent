DATABASE_URL=postgresql+psycopg2://digest_user:digest_pass@localhost:5432/digest_db

# Admin token for the JSON API (sent as the X-Admin-Token header); empty locks
# the API. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Summaries, relevance ratings and overviews come from the OpenAI API, billed
# per token. SUMMARY_BACKEND=ollama uses a local model instead (needs `ollama
# pull gemma3:12b`, no API key or per-call cost). SUMMARY_BACKEND=none turns
# summarization off: digests and emails still work, just without AI-written
# text.
OPENAI_API_KEY=
# SUMMARY_BACKEND=openai
# OPENAI_MODEL=gpt-5.4-mini

# Spend guard: every OpenAI call is recorded with its cost. At 80% of the
# monthly budget (UTC month) the owner is alerted; at 100% AI text stops until
# the 1st and digests go out without it. Alerts are emailed to ALERT_EMAIL
# (only logged while it's empty). Prices are USD per 1M tokens; a model with
# no price can't be called.
# OPENAI_MONTHLY_BUDGET_USD=20
# ALERT_EMAIL=you@example.com
# OPENAI_PRICES={"gpt-5.4-mini": {"input": 0.75, "cached_input": 0.075, "output": 4.50}, "text-embedding-3-small": {"input": 0.02, "cached_input": 0.02, "output": 0.0}}

# Paper embeddings for retrieval (pgvector) come from OpenAI's
# text-embedding-3-small at 768 dimensions, priced and recorded like every
# OpenAI call. Off whenever SUMMARY_BACKEND=none, or with RAG_ENABLED=false.
# For local development, EMBEDDING_BACKEND=ollama EMBEDDING_MODEL=embeddinggemma
# uses Ollama on the Mac (`brew install ollama && brew services start ollama
# && ollama pull embeddinggemma`).
# OLLAMA_BASE_URL=http://host.docker.internal:11434   # docker-compose default
# RAG_ENABLED=true
# EMBEDDING_BACKEND=openai
# EMBEDDING_MODEL=text-embedding-3-small
# Similarity thresholds per embedding model (merged over the defaults in
# app/config.py; measure a new model with `python -m evals.embeddings`):
# RETRIEVAL_CALIBRATION={"my-model": {"similar_paper": 0.6, "near_duplicate": 0.85, "related_min": 0.55, "novelty_repeat": 0.75, "novelty_unrelated": 0.3, "topic_suggestion": 0.7}}
# LLM-written related-work notes in emails. Off: in review, about a quarter
# misdescribed the cited paper (docs/rag-plan.md §5.3). With it off, emails
# show the closest earlier paper as a plain link instead.
# RAG_RELATED_NOTES=false
# Overviews see the topic's last 3 overviews so they don't repeat them
# (docs/rag-plan.md §5.6).
# RAG_OVERVIEW_HISTORY=true
# Summaries use excerpts from each paper's full text (arXiv HTML, fetched
# from export.arxiv.org at most once per 3 s and kept locally - never
# emailed). docs/rag-plan.md §5.7.
# RAG_FULLTEXT=true

# Optional: Semantic Scholar API key (free, by application) for the author
# h-index used to rank papers when a subscription caps how many it gets.
# Without one, h-indices come from OpenAlex instead - no key needed, but it
# indexes new arXiv papers a few days later, so more of each email's newest
# papers go without that signal.
# https://www.semanticscholar.org/product/api#api-key-form
# SEMANTIC_SCHOLAR_API_KEY=your-key-here

# Optional overrides (defaults shown)
# ARXIV_MAX_RESULTS=25
# ARXIV_PAGE_DELAY=3.0
# ARXIV_LOOKBACK_DAYS=7
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=digest-task-queue

# Email delivery (SMTP). Defaults point at Mailpit (docker-compose) - nothing
# leaves the machine until these are pointed at a real relay.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# SMTP_FROM_ADDRESS=digest@example.com
